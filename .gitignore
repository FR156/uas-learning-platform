# Dependencies
node_modules/

# Build output (regenerated by `npm run build`)
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Intermediate PDF-extraction artifacts.
# These contain verbatim copies of the source course material (rendered page
# images and extracted prose) and are not needed to build or run the site.
source-extraction/

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Vercel
.vercel
